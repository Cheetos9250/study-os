  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled main action; hover re-inks it in the cover accent.",
      "html": "<button class=\"ds-btn-primary\">Start quiz</button>",
      "css": ".ds-btn-primary{font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-weight:700;font-size:14px;min-height:42px;padding:0 16px;border-radius:6px;border:2.5px solid var(--ink,#111);background:var(--ink,#111);color:var(--accent-ink,#fff);cursor:pointer;transition:background .15s}.ds-btn-primary:hover{background:var(--acc,#e02c1f);color:var(--acc-ink,#fff)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus,#111);outline-offset:3px;box-shadow:0 0 0 6px var(--acc-soft,#fbe9e8)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary action on paper with an ink outline.",
      "html": "<button class=\"ds-btn-outline\">Practice</button>",
      "css": ".ds-btn-outline{font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-weight:700;font-size:14px;min-height:42px;padding:0 16px;border-radius:6px;border:2.5px solid var(--ink,#111);background:var(--panel,#fff);color:var(--text,#111);cursor:pointer}.ds-btn-outline:hover{background:var(--panel-2,#f0f0ee)}.ds-btn-outline:focus-visible{outline:3px solid var(--focus,#111);outline-offset:3px;box-shadow:0 0 0 6px var(--acc-soft,#fbe9e8)}"
    },
    {
      "name": "Go Button",
      "kind": "button",
      "refersTo": "button-go",
      "description": "The single lead action on a page, in the cover accent.",
      "html": "<a class=\"ds-go\" href=\"#\">Start Accounting quiz</a>",
      "css": ".ds-go{font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-weight:900;font-size:15px;min-height:46px;padding:0 22px;border-radius:6px;background:var(--acc,#e02c1f);color:var(--acc-ink,#fff);border:3px solid var(--ink,#111);display:inline-flex;align-items:center;text-decoration:none;white-space:nowrap}.ds-go:hover{filter:brightness(1.05)}.ds-go:focus-visible{outline:3px solid var(--focus,#111);outline-offset:3px;box-shadow:0 0 0 6px var(--acc-soft,#fbe9e8)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Paper field with a 2px ink stroke and accent caret.",
      "html": "<input class=\"ds-input\" placeholder=\"Add a task\">",
      "css": ".ds-input{font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-size:14px;min-height:44px;padding:0 10px;border-radius:6px;border:2px solid var(--ink,#111);background:var(--panel,#fff);color:var(--text,#111);caret-color:var(--acc,#e02c1f)}.ds-input::placeholder{color:var(--muted,#505050)}.ds-input:focus-visible{outline:3px solid var(--focus,#111);outline-offset:3px;box-shadow:0 0 0 6px var(--acc-soft,#fbe9e8)}"
    },
    {
      "name": "Course Tag",
      "kind": "chip",
      "refersTo": "course-tag",
      "description": "Course-tone tag with black text and an ink outline.",
      "html": "<span class=\"ds-tag\" style=\"--team:#8fb2f4\">Accounting</span> <span class=\"ds-tag\" style=\"--team:#f4ad7f\">Economics</span>",
      "css": ".ds-tag{display:inline-block;font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-weight:900;font-size:11px;line-height:1.6;padding:0 8px;border-radius:4px;border:2px solid var(--ink,#111);background:var(--team,#ececec);color:#111}"
    },
    {
      "name": "Ink Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "The manga frame: 3px ink, 2px corners, no shadow; the now variant is accent-hatched.",
      "html": "<div class=\"ds-panel\"><b class=\"ds-n\">0</b><span>Cards due</span></div><div class=\"ds-panel ds-now\"><b class=\"ds-n ds-ko\">1</b><span class=\"ds-ko\">day to exam</span></div>",
      "css": ".ds-panel{display:inline-flex;flex-direction:column;gap:2px;min-width:150px;margin:4px;padding:16px 18px;background:var(--panel,#fff);color:var(--text,#111);border:3px solid var(--ink,#111);border-radius:2px;font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;font-weight:900;font-size:14px}.ds-now{background:repeating-linear-gradient(-45deg,var(--acc,#e02c1f) 0 1.5px,transparent 1.5px 8px),var(--panel,#fff)}.ds-n{font:700 52px/1.05 'Kaisei Decol',serif}.ds-ko{background:var(--panel,#fff);width:fit-content;padding:0 4px}"
    },
    {
      "name": "Speech-Bubble Lead Panel",
      "kind": "custom",
      "refersTo": "speech-bubble",
      "description": "Signature: the next step spoken from an ink bubble in a hatched frame, with one Go action.",
      "html": "<section class=\"ds-lead\"><div class=\"ds-bub\"><b>Warm up: Accounting quiz</b><span>Accounting quiz in 1 day</span></div><a class=\"ds-lead-go\" href=\"#\">Start</a></section>",
      "css": ".ds-lead{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;padding:18px 20px 26px;border:3px solid var(--ink,#111);border-radius:2px;background:repeating-linear-gradient(-45deg,var(--acc,#e02c1f) 0 1.5px,transparent 1.5px 8px),var(--panel,#fff);font-family:'Zen Maru Gothic','Mali',system-ui,sans-serif;}.ds-bub{position:relative;isolation:isolate;max-width:420px;background:var(--panel,#fff);border:3px solid var(--ink,#111);border-radius:50%;padding:18px 34px 20px;text-align:center;color:var(--text,#111)}.ds-bub::before{content:'';position:absolute;z-index:-1;left:16%;bottom:-24px;width:30px;height:40px;background:var(--ink,#111);clip-path:polygon(0 0,100% 0,6% 100%)}.ds-bub::after{content:'';position:absolute;z-index:1;left:calc(16% + 4.5px);bottom:-16.5px;width:20px;height:30px;background:var(--panel,#fff);clip-path:polygon(0 0,100% 0,6% 100%)}.ds-bub b{display:block;font:700 24px/1.25 'Kaisei Decol',serif}.ds-bub span{display:block;color:var(--muted,#505050);font-weight:700;font-size:14px}.ds-lead-go{font-weight:900;font-size:15px;min-height:46px;padding:0 22px;border-radius:6px;background:var(--acc,#e02c1f);color:var(--acc-ink,#fff);border:3px solid var(--ink,#111);display:inline-flex;align-items:center;text-decoration:none}.ds-lead-go:focus-visible{outline:3px solid var(--focus,#111);outline-offset:3px}"
    },
    {
      "name": "Navigation Rail",
      "kind": "nav",
      "refersTo": "nav-tab-active",
      "description": "White rail with an ink edge; the current page is a black pill.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-brand\">Study <b>OS</b></div><a class=\"ds-tab\" aria-current=\"page\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2\"/></svg>Today</a><a class=\"ds-tab\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"7\" y=\"3\" width=\"13\" height=\"15\" rx=\"1\"/><path d=\"M4 7v13h12\"/></svg>Flashcards</a></nav>",
